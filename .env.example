# Copier ce fichier vers .env, puis adapter les valeurs locales.
# Ne jamais committer .env.

APP_ENV=local
LOG_LEVEL=INFO
DOCS_ENABLED=true

POSTGRES_DB=suivi_depenses
POSTGRES_USER=suivi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optionnel : prioritaire sur POSTGRES_* pour l'application et Alembic.
# DATABASE_URL=postgresql+psycopg://suivi:change-me-local-only@127.0.0.1:5432/suivi_depenses

# Cookies et sessions
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=2592000
INVITATION_TTL_SECONDS=604800

# Laisser vide en local.
SENTRY_DSN=
